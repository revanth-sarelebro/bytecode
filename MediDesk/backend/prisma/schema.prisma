generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PATIENT
  DOCTOR
  ADMIN
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model User {
  id           Int       @id @default(autoincrement())
  name         String
  email        String    @unique
  passwordHash String
  role         Role      @default(PATIENT)
  failedLogins Int       @default(0)
  lockedUntil  DateTime?
  isDecoy      Boolean   @default(false)
  createdAt    DateTime  @default(now())

  patientProfile PatientProfile?
  doctorProfile  DoctorProfile?

  patientAppointments Appointment[] @relation("PatientAppointments")
  doctorAppointments  Appointment[] @relation("DoctorAppointments")

  patientRecords MedicalRecord[] @relation("PatientRecords")
  doctorRecords  MedicalRecord[] @relation("DoctorRecords")
  auditLogs      AuditLog[]
  patientReports     Report[]     @relation("PatientReports")
  doctorReports      Report[]     @relation("DoctorReports")
  patientMedications Medication[] @relation("PatientMedications")
  doctorMedications  Medication[] @relation("DoctorMedications")
}

model PatientProfile {
  id          Int     @id @default(autoincrement())
  userId      Int     @unique
  phone       String?
  dateOfBirth String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DoctorProfile {
  id             Int     @id @default(autoincrement())
  userId         Int     @unique
  specialization String
  licenseNumber  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Appointment {
  id          Int               @id @default(autoincrement())
  patientId   Int
  doctorId    Int
  dateTime    DateTime
  status      AppointmentStatus @default(PENDING)
  reason      String?
  bookingCode String?           @unique
  checkedInAt DateTime?
  createdAt   DateTime          @default(now())

  patient User @relation("PatientAppointments", fields: [patientId], references: [id], onDelete: Cascade)
  doctor  User @relation("DoctorAppointments", fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([doctorId])
}

model MedicalRecord {
  id           Int      @id @default(autoincrement())
  patientId    Int
  doctorId     Int
  diagnosis    String
  prescription String?
  date         DateTime @default(now())

  patient User @relation("PatientRecords", fields: [patientId], references: [id], onDelete: Cascade)
  doctor  User @relation("DoctorRecords", fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([doctorId])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  action    String
  entity    String
  entityId  Int?
  details   String?
  ipAddress String?
  prevHash  String?
  hash      String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

enum ReportType {
  BLOOD_TEST
  XRAY
  SCAN
  OTHER
}

model Report {
  id         Int        @id @default(autoincrement())
  patientId  Int
  doctorId   Int
  type       ReportType
  title      String
  results    Json       @default("[]")
  findings   String?
  impression String?
  createdAt  DateTime   @default(now())

  patient User @relation("PatientReports", fields: [patientId], references: [id], onDelete: Cascade)
  doctor  User @relation("DoctorReports", fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([doctorId])
}

model Medication {
  id           Int      @id @default(autoincrement())
  patientId    Int
  doctorId     Int
  name         String
  dosage       String
  frequency    String
  durationDays Int
  startDate    DateTime @default(now())
  notes        String?

  patient User @relation("PatientMedications", fields: [patientId], references: [id], onDelete: Cascade)
  doctor  User @relation("DoctorMedications", fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([doctorId])
}
